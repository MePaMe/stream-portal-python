try:
    import vlc
except ImportError:
    vlc = None


class ChannelConfig:
    def __init__(self, path: str = "channels.json"):
        self.path = Path(path)
        self.data = self._load()

    def _load(self):
        if not self.path.exists():
            return {}
        try:
            with open(self.path, "r", encoding="utf-8") as f:
                data = json.load(f)
            if isinstance(data, dict):
                return data
        except Exception:
            return {}
        return {}

    def normalize_mac(self, mac: str) -> str:
        if not mac:
            return ""
        return mac.strip().replace("-", ":").lower()

    def add_channel(self, mac: str, name: str, url: str):
        mac_key = self.normalize_mac(mac)
        if not mac_key:
            raise ValueError("Mac adresë e pavlefshme")
        if not name or not url:
            raise ValueError("Emri dhe URL-ja janë të detyrueshme")

        self.data.setdefault(mac_key, [])
        for item in self.data[mac_key]:
            if item.get("name", "").lower() == name.lower() and item.get("url", "") == url:
                return
        self.data[mac_key].append({"name": name, "url": url})
        self.save()

    def remove_channel(self, mac: str, channel_name: str):
        mac_key = self.normalize_mac(mac)
        self.data.setdefault(mac_key, [])
        self.data[mac_key] = [
            ch for ch in self.data[mac_key] if ch.get("name") != channel_name
        ]
        if not self.data[mac_key]:
            self.data.pop(mac_key, None)
        self.save()

    def save(self):
        with open(self.path, "w", encoding="utf-8") as f:
            json.dump(self.data, f, indent=2, ensure_ascii=False)

    def get_mac_keys(self):
        return sorted(self.data.keys())

    def get_channels_for_mac(self, mac: str):
        mac_key = self.normalize_mac(mac)
        return self.data.get(mac_key, [])

    def set_channels_for_mac(self, mac: str, channels):
        mac_key = self.normalize_mac(mac)
        self.data[mac_key] = channels
        self.save()


def normalize_mac(mac: str) -> str:
    return mac.strip().replace("-", ":").lower() if mac else ""


def detect_local_macs():
    macs = []
    interfaces = []

    try:
        interfaces = [
            i[1]
            for i in socket.if_nameindex()
            if i[1] not in ("lo", "lo0")
        ]
    except Exception:
        interfaces = []

    for iface in interfaces:
        try:
            mac = get_interface_mac(iface)
            if mac:
                macs.append(mac)
        except Exception:
            pass

    if not macs:
        try:
            hostname = socket.gethostname()
            mac = "00:00:00:00:00:00"
            macs.append(mac)
            if hostname:
                pass
        except Exception:
            pass

    return sorted(set(macs))


def get_interface_mac(interface_name: str):
    if platform.system() == "Darwin":
        try:
            result = subprocess.check_output(["ifconfig", interface_name], text=True, stderr=subprocess.DEVNULL)
            for line in result.splitlines():
                if "ether" in line.lower():
                    parts = line.split()
                    for p in parts:
                        if ":" in p and len(p.split(":")) == 6:
                            return normalize_mac(p)
        except Exception:
            return ""

    if platform.system() == "Linux":
        try:
            result = subprocess.check_output(["cat", f"/sys/class/net/{interface_name}/address"], text=True, stderr=subprocess.DEVNULL)
            mac = result.strip()
            if mac and mac != "00:00:00:00:00:00":
                return normalize_mac(mac)
        except Exception:
            return ""

    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        info = fcntl.ioctl(sock.fileno(), 0x8927, struct.pack("256s", interface_name[:15].encode("utf-8")))
        mac = ":".join(f"{b:02x}" for b in info[18:24])
        return normalize_mac(mac)
    except Exception:
        return ""


try:
    import fcntl
