except ImportError:
    fcntl = None
    struct = None


def import_m3u_file(m3u_path: str, output_json_path: str = "channels.json"):
    channels_by_mac = {}
    parser = M3UParser(m3u_path)
    parsed = parser.parse()
    if parsed:
        # default: assign same playlist to first detected MAC if exists
        mac_candidates = detect_local_macs()
        target_mac = mac_candidates[0] if mac_candidates else "00:00:00:00:00:00"
        channels_by_mac[target_mac] = parsed

    cfg = ChannelConfig(output_json_path)
    cfg.data.update(channels_by_mac)
    cfg.save()
    return channels_by_mac


class M3UParser:
    def __init__(self, file_path: str):
        self.file_path = file_path

    def parse(self):
        if not os.path.exists(self.file_path):
            raise FileNotFoundError(self.file_path)

        channels = []
        name = "Unknown"
        with open(self.file_path, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                if line.startswith("#EXTINF"):
                    if "," in line:
                        name = line.split(",", 1)[1].strip()
                    continue
                if line.startswith(("http://", "https://", "rtmp://", "udp://", "rtsp://")):
                    channels.append({"name": name or "Unknown", "url": line})
                    name = "Unknown"
        return channels


class StreamPlayer:
    def __init__(self):
        self.instance = None
        self.player = None
        self._vlc_loaded = self._load_vlc()

    def _load_vlc(self):
        if vlc is None:
            return False
        try:
            self.instance = vlc.Instance()
            self.player = self.instance.media_player_new()
            return True
        except Exception:
            return False

    def open_url(self, url: str):
        if not self._vlc_loaded:
            return self._fallback_open(url)

        try:
            media = self.instance.media_new(url)
            self.player.set_media(media)
            self.player.play()
            return True
        except Exception:
            return self._fallback_open(url)

    def _fallback_open(self, url: str):
        if platform.system() == "Darwin":
            launchers = [
                ["open", "-a", "VLC", url],
                ["vlc", url],
                ["ffplay", "-autoexit", url],
            ]
        else:
            launchers = [
                ["vlc", url],
                ["ffplay", "-autoexit", url],
            ]

        for command in launchers:
            try:
                subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                return True
            except Exception:
                continue
        return False


class StreamPortalApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Stream Portal")
        self.root.geometry("1100x720")
        self.root.minsize(900, 600)

        self.config = ChannelConfig("channels.json")
        self.player = StreamPlayer()

        self.mac_var = tk.StringVar()
        self.name_var = tk.StringVar()
        self.url_var = tk.StringVar()

        self._build_ui()
        self.refresh_macs()

    def _build_ui(self):
        main = ttk.Frame(self.root, padding=12)
        main.pack(fill=tk.BOTH, expand=True)

        upper = ttk.Frame(main)
        upper.pack(fill=tk.X, pady=(0, 8))

        ttk.Label(upper, text="MAC Address:").pack(side=tk.LEFT)
        self.mac_combo = ttk.Combobox(upper, textvariable=self.mac_var, width=24)
        self.mac_combo.pack(side=tk.LEFT, padx=(8, 12))

        ttk.Button(upper, text="Refresh MACs", command=self.refresh_macs).pack(side=tk.LEFT)
        ttk.Button(upper, text="Add from detected", command=self.detect_and_select_mac).pack(side=tk.LEFT, padx=(8,0))

        form = ttk.LabelFrame(main, text="Add Channel")
        form.pack(fill=tk.X, pady=(0, 10))

        fields = ttk.Frame(form, padding=10)
        fields.pack(fill=tk.X)

        ttk.Label(fields, text="Name").grid(row=0, column=0, sticky="w", padx=(0, 8), pady=4)
        ttk.Entry(fields, textvariable=self.name_var, width=40).grid(row=0, column=1, sticky="ew", padx=(0, 12))

        ttk.Label(fields, text="URL").grid(row=1, column=0, sticky="w", padx=(0, 8), pady=4)
        ttk.Entry(fields, textvariable=self.url_var, width=80).grid(row=1, column=1, sticky="ew", padx=(0, 12))

        buttons = ttk.Frame(fields)
        buttons.grid(row=2, column=1, sticky="w", pady=(10, 0))
        ttk.Button(buttons, text="Add Channel", command=self.add_channel).pack(side=tk.LEFT)
        ttk.Button(buttons, text="Import M3U", command=self.import_m3u).pack(side=tk.LEFT, padx=(8,0))
        ttk.Button(buttons, text="Open Selected", command=self.open_selected_channel).pack(side=tk.LEFT, padx=(8,0))

        content = ttk.Frame(main)
        content.pack(fill=tk.BOTH, expand=True)

        left = ttk.LabelFrame(content, text="Channels")
        left.pack(side=tk.LEFT, fill=tk.BOTH, expand=True, padx=(0, 10))

        columns = ("Name", "URL")
        self.channels_tree = ttk.Treeview(left, columns=columns, show="headings", height=20)
        self.channels_tree.heading("Name", text="Name")
        self.channels_tree.heading("URL", text="URL")
        self.channels_tree.column("Name", width=220, anchor="w")
        self.channels_tree.column("URL", width=520, anchor="w")
        self.channels_tree.pack(fill=tk.BOTH, expand=True, padx=8, pady=8)

        self.channels_tree.bind("<Double-1>", self.double_click_channel)

        right = ttk.LabelFrame(content, text="MACs")
        right.pack(side=tk.RIGHT, fill=tk.Y, padx=(10, 0))

        self.mac_listbox = tk.Listbox(right, height=28, width=22, exportselection=False)
        self.mac_listbox.pack(fill=tk.BOTH, expand=True, padx=8, pady=8)
        self.mac_listbox.bind("<<ListboxSelect>>", self.on_mac_selected)

        ttk.Button(right, text="Delete Selected MAC", command=self.delete_selected_mac).pack(fill=tk.X, padx=8, pady=(0, 8))
        ttk.Button(right, text="Delete Selected Channel", command=self.delete_selected_channel).pack(fill=tk.X, padx=8, pady=(0, 8))

    def detect_and_select_mac(self):
        macs = detect_local_macs()
        if not macs:
            messagebox.showinfo("Info", "Nuk u zbulua asnjë MAC address")
            return
        self.mac_var.set(macs[0])
        self.mac_combo.set(macs[0])
        self.refresh_channels()

    def refresh_macs(self):
        current = self.mac_var.get()
        macs = detect_local_macs() + self.config.get_mac_keys()
        unique = []
        for mac in sorted(set(macs)):
            if mac not in unique:
                unique.append(mac)

        self.mac_combo["values"] = unique
        self.mac_listbox.delete(0, tk.END)
        for mac in unique:
            self.mac_listbox.insert(tk.END, mac)

        if current in unique:
            self.mac_var.set(current)
            self.mac_combo.set(current)
        elif unique:
            self.mac_var.set(unique[0])
            self.mac_combo.set(unique[0])
        self.refresh_channels()

    def on_mac_selected(self, event):
        selection = self.mac_listbox.curselection()
        if not selection:
            return
        mac = self.mac_listbox.get(selection[0])
        self.mac_var.set(mac)
        self.mac_combo.set(mac)
        self.refresh_channels()

    def add_channel(self):
        mac = self.mac_var.get().strip()
        name = self.name_var.get().strip()
        url = self.url_var.get().strip()

        if not mac:
            messagebox.showerror("Gabim", "Zgjidh ose shkruaj një MAC adresë.")
            return

        try:
            self.config.add_channel(mac, name, url)
            self.name_var.set("")
            self.url_var.set("")
            self.refresh_macs()
            self.refresh_channels()
            messagebox.showinfo("Sukses", "Kanali u shtua me sukses.")
        except ValueError as e:
            messagebox.showerror("Gabim", str(e))

    def import_m3u(self):
        path = filedialog.askopenfilename(title="Zgjidh M3U file", filetypes=[("M3U files", "*.m3u *.m3u8 *.txt")])
        if not path:
            return
        try:
            parsed = M3UParser(path).parse()
            mac = self.mac_var.get().strip()
            if not mac:
                mac = detect_local_macs()[0] if detect_local_macs() else "00:00:00:00:00:00"
            self.config.set_channels_for_mac(mac, parsed)
            self.refresh_macs()
            self.refresh_channels()
            messagebox.showinfo("Sukses", f"U importuan {len(parsed)} kanale për MAC {mac}.")
        except Exception as exc:
            messagebox.showerror("Gabim", f"Importimi dështoi: {exc}")

    def delete_selected_mac(self):
        selected = self.mac_listbox.curselection()
        if not selected:
            return
        mac = self.mac_listbox.get(selected[0])
        self.config.data.pop(normalize_mac(mac), None)
        self.config.save()
        self.refresh_macs()

    def delete_selected_channel(self):
        selection = self.channels_tree.selection()
        if not selection:
            return
        item = self.channels_tree.item(selection[0])
        name = item["values"][0]
        mac = self.mac_var.get().strip()
        if not mac:
            return
        self.config.remove_channel(mac, name)
        self.refresh_channels()

    def refresh_channels(self):
        mac = self.mac_var.get().strip()
        self.channels_tree.delete(*self.channels_tree.get_children())
        if not mac:
            return
        channels = self.config.get_channels_for_mac(mac)
        for ch in channels:
            self.channels_tree.insert("", tk.END, values=(ch.get("name", "Unknown"), ch.get("url", "")))

    def open_selected_channel(self):
        selection = self.channels_tree.selection()
        if not selection:
            messagebox.showinfo("Info", "Zgjidh një kanal për tu hapur.")
            return
        item = self.channels_tree.item(selection[0])
        url = item["values"][1]
        if not url:
            messagebox.showerror("Gabim", "URL-ja e kanalit mungon.")
            return

        ok = self.player.open_url(url)
        if not ok:
            messagebox.showerror("Gabim", "Nuk mund të hapej stream-i. Kontrollo VLC ose ffplay.")

    def double_click_channel(self, event):
        self.open_selected_channel()


def create_default_config(path: str = "channels.json"):
    default = {
        "00:11:22:33:44:55": [
            {"name": "TV1", "url": "http://example.com/tv1.m3u8"},
            {"name": "SPORT", "url": "http://example.com/sport.m3u8"},
            {"name": "RTMP Demo", "url": "rtmp://example.com/live/channel1"},
        ],
        "aa:bb:cc:dd:ee:ff": [
            {"name": "News HD", "url": "https://example.com/news.m3u8"}
        ],
    }
    cfg = ChannelConfig(path)
    if not cfg.data:
        cfg.data = default
        cfg.save()


def main():
    create_default_config("channels.json")
    root = tk.Tk()
    app = StreamPortalApp(root)
    root.mainloop()


if __name__ == "__main__":
    main()
